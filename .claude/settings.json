{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(node_modules/.bin/*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -r /*)",
      "Bash(rm --no-preserve-root*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(sudo -s*)",
      "Bash(sudo -i*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod 777*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(fdisk*)",
      "Bash(shred *)",
      "Bash(:(){*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(npm publish*)",
      "Bash(pkill -9 *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(launchctl*)"
    ]
  },
  "includeCoAuthoredBy": true,
  "cleanupPeriodDays": 30,
  "respectGitignore": true,
  "showTurnDuration": true,
  "autoUpdatesChannel": "stable",
  "language": "fr",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/abderaoufniati/Desktop/Developer/Claude/MeetingMirror/.claude/hooks/prettier.sh"
          }
        ]
      }
    ]
  }
}
